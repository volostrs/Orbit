```gitignore
# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*

# Allow required Yarn configuration files
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/

# Build and deployment output
build/
dist/
.vercel/
.turbo/

# Testing and coverage
coverage/

# Environment files and secrets
.env*
!.env.example
!.env.template

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Local Claude settings and instructions
CLAUDE.local.md
.claude/settings.local.json

# Local databases
*.sqlite
*.sqlite3

# Logs and debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript generated files
*.tsbuildinfo
next-env.d.ts

# Operating system files
.DS_Store
Thumbs.db
```
